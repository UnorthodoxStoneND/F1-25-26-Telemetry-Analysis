{
  "schema_version": 1,
  "id": "unorthodoxstonendmodding.udp-telemetry",
  "name": "F1 Live Telemetry & Analysis",
  "version": "0.7.0-prototype.3",
  "author": "UnorthodoxStoneNDmodding",
  "description": "Live timing in the launcher or retro window, with optional session recording, practice rankings and CSV export in Telemetry Analysis.",
  "license": "MIT",
  "repository": "https://github.com/UnorthodoxStoneND/F1-25-26-Telemetry-Analysis",
  "category": "utility",
  "icon": "icon.png",
  "kind": [
    "native"
  ],
  "compat": {
    "game": "f1_25",
    "launcher": ">=1.10.9",
    "platforms": [
      "steam"
    ]
  },
  "requires": [
    {
      "id": "swofty.core",
      "version": ">=0.1.0"
    }
  ],
  "experimental_features": [
    "telemetry"
  ],
  "saves": {
    "affects": false
  },
  "options": [
    {
      "id": "drivers_shown",
      "type": "choice",
      "label": "Drivers shown",
      "default": "nearest",
      "binds": "native",
      "values": [
        {
          "value": "nearest",
          "label": "Nearest cars (you + 4)"
        },
        {
          "value": "full",
          "label": "Full grid"
        }
      ]
    },
    {
      "id": "highlight_player",
      "type": "toggle",
      "label": "Highlight my row",
      "default": false,
      "binds": "native"
    },
    {
      "id": "show_practice",
      "type": "toggle",
      "label": "Practice session view",
      "default": true,
      "binds": "native"
    },
    {
      "id": "show_qualifying",
      "type": "toggle",
      "label": "Qualifying / Sprint Qualifying session view",
      "default": true,
      "binds": "native"
    },
    {
      "id": "show_race",
      "type": "toggle",
      "label": "Sprint / Race session view",
      "default": true,
      "binds": "native"
    },
    {
      "id": "display_mode",
      "type": "choice",
      "label": "Telemetry display",
      "default": "launcher",
      "binds": "native",
      "values": [
        {
          "value": "launcher",
          "label": "Launcher page"
        },
        {
          "value": "window",
          "label": "Retro window"
        }
      ]
    },
    {
      "id": "sliding_animation",
      "type": "toggle",
      "label": "Sliding row animation (retro window)",
      "default": true,
      "binds": "native"
    },
    {
      "id": "enable_analysis",
      "type": "toggle",
      "label": "Enable Telemetry Analysis",
      "default": false,
      "binds": "native"
    }
  ],
  "operations": {
    "native": [
      {
        "dll": "bin/telemetry-live.dll"
      }
    ]
  },
  "launcher": {
    "program": {
      "windows": "bin/telemetry-live.exe",
      "linux": "bin/telemetry-live-linux"
    },
    "sections": [
      {
        "id": "telemetry",
        "title": "Live Telemetry",
        "icon": "activity"
      },
      {
        "id": "analysis",
        "title": "Telemetry Analysis",
        "icon": "activity"
      }
    ],
    "startup": true
  }
}
