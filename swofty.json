{
  "schema_version": 1,
  "id": "unorthodoxstonendmodding.udp-telemetry",
  "name": "F1 Live Telemetry",
  "version": "0.5.5",
  "author": "UnorthodoxStoneNDmodding",
  "description": "Live driver positions, tyres, wear, lap times and car setups, read from the game through Swofty's binding system. Live display only; no UDP or recording.",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/UnorthodoxStoneND/F1-25-26-Telemetry-Analysis",
  "category": "utility",
  "kind": ["native"],
  "compat": {"game": "f1_25", "launcher": ">=1.9.55"},
  "requires": [{"id": "swofty.core", "version": ">=0.1.0"}],
  "experimental_features": ["telemetry"],
  "saves": {"affects": false},
  "options": [
    {
      "id": "drivers_shown", "type": "choice", "label": "Drivers shown", "default": "nearest", "binds": "native",
      "values": [{"value": "nearest", "label": "Nearest cars (you + 4)"}, {"value": "full", "label": "Full grid"}]
    },
    {"id": "highlight_player", "type": "toggle", "label": "Highlight my row", "default": false, "binds": "native"}
  ],
  "operations": {"native": [{"dll": "bin/telemetry-live.dll"}]},
  "launcher": {
    "program": {"windows": "bin/telemetry-live.exe"},
    "sections": [{"id": "telemetry", "title": "Live Telemetry", "icon": "activity"}],
    "startup": true
  }
}
