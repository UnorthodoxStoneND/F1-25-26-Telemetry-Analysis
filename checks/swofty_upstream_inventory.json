      ],
      "steps": [
        "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "actions-rust-lang/setup-rust-toolchain@v2",
        "Swatinem/rust-cache@v2",
        "Build",
        "Upload the executable"
      ]
    },
    {
      "upstream": "ci.yml:docs",
      "checks": [
        "Swofty documentation build"
      ],
      "steps": [
        "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "pnpm/setup@v3",
